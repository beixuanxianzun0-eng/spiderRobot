  <actuator>
    <!-- 保留现有十八个电机名称，C++ 控制接口无需改名。 -->
    <motor name="front_left_root_motor" joint="front_left_root_joint" ctrlrange="-8 8" />
    <motor name="front_left_middle_motor" joint="front_left_middle_joint" ctrlrange="-8 8" />
    <motor name="front_left_distal_motor" joint="front_left_distal_joint" ctrlrange="-8 8" />
