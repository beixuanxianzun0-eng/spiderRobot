          <body name="front_left_distal" pos="0.07 0 0">
            <joint name="front_left_distal_joint" type="hinge" axis="0 0 1" range="-3.1415927 0" damping="0.3" />
            <geom name="front_left_foot_collision" type="capsule" fromto="0 0 0 0.13 0 0" size="0.010" mass="0.0013722" rgba="0.86 0.18 0.12 1" />
          </body>
        </body>
      </body>

      <!-- 右前腿：官方 R1 安装位置和负 30 度方向。 -->
      <body name="front_right_leg" pos="0.0952628 -0.055 0" euler="0 0 -0.5235988">
        <joint name="front_right_root_joint" type="hinge" axis="0 0 1" range="-1.5707963 1.5707963" damping="0.3" />
