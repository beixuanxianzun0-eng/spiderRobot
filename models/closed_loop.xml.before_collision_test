      <!-- 左前腿：官方 L1 安装位置和 30 度方向。 -->
      <body name="front_left_leg" pos="0.0952628 0.055 0" euler="0 0 0.5235988">
        <joint name="front_left_root_joint" type="hinge" axis="0 0 1" range="-1.5707963 1.5707963" damping="0.3" />
