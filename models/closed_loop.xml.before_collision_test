<mujoco model="hexumi">
  <!-- 使用 Hexumi 官方 URDF 的米制尺寸和关节坐标。 -->
  <compiler angle="radian" />
  <option timestep="0.002" gravity="0 0 -9.81" />

  <default>
    <!-- 简单几何体同时负责骨架显示、质量和稳定碰撞。 -->
    <geom contype="1" conaffinity="1" friction="1.5 0.005 0.0001" solref="0.01 1" solimp="0.90 0.99 0.001" />
  </default>

